{
  "name": "shopify-compressor-pro",
  "version": "1.0.3",
  "description": "Shopify Compressor Pro — Advanced asset optimization for Shopify themes with parallel processing, HTML reports, asset budgets, and more.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "bin": {
    "shopify-compressor-pro": "./dist/cli.js",
    "scomp-pro": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest",
    "test:coverage": "vitest --coverage",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build && npm run test",
    "bundle": "node dist/cli.js build"
  },
  "dependencies": {
    "chalk": "^5.3.0",
    "chokidar": "^3.5.3",
    "commander": "^11.1.0",
    "consola": "^3.2.3",
    "esbuild": "^0.19.8",
    "glob": "^10.3.10",
    "image-size": "^1.1.1",
    "lightningcss": "^1.22.1",
    "ora": "^8.0.1",
    "sass": "^1.69.5",
    "sharp": "^0.33.1",
    "shopify-compressor": "^2.0.0",
    "svgo": "^3.1.0"
  },
  "devDependencies": {
    "@types/node": "^20.10.4",
    "@typescript-eslint/eslint-plugin": "^6.14.0",
    "@typescript-eslint/parser": "^6.14.0",
    "eslint": "^8.55.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.1.1",
    "tsup": "^8.0.1",
    "typescript": "^5.3.3",
    "vitest": "^1.0.4"
  },
  "keywords": [
    "shopify",
    "compressor",
    "bundler",
    "minifier",
    "webp",
    "avif",
    "image-optimization",
    "css",
    "javascript",
    "liquid",
    "scss",
    "sass",
    "svg",
    "performance",
    "shopify-theme",
    "assets",
    "parallel",
    "reports",
    "budgets",
    "pro"
  ],
  "author": "Ben Toms",
  "license": "SEE LICENSE IN LICENSE",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bentoms-dev/shopify-compressor-pro.git"
  },
  "bugs": {
    "url": "https://github.com/bentoms-dev/shopify-compressor-pro/issues"
  },
  "homepage": "https://bentoms.lemonsqueezy.com/"
}
